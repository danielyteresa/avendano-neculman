---
// Íconos simples de línea. Son decorativos: el texto o el aria-label del
// enlace es lo que leen los lectores de pantalla.
import type { SocialNetwork } from "../../data/types";

export type IconName =
  SocialNetwork | "whatsapp" | "phone" | "mail" | "pin" | "clock";

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  whatsapp:
    "M12 3a9 9 0 0 0-7.8 13.5L3 21l4.6-1.2A9 9 0 1 0 12 3ZM9 8.2c.3-.4.7-.4 1-.1l1 1.6c.2.3.1.7-.2 1l-.5.5a5 5 0 0 0 2.5 2.5l.5-.5c.3-.3.7-.4 1-.2l1.6 1c.3.3.3.7-.1 1-1 1-2.6 1-4.3 0a9 9 0 0 1-2.6-2.6C7.9 10.8 8 9.2 9 8.2Z",
  facebook:
    "M15 3h-2a4 4 0 0 0-4 4v3H7v4h2v7h4v-7h2.5l.5-4h-3V7.5c0-.6.4-1 1-1h2V3Z",
  instagram:
    "M7.5 3h9A4.5 4.5 0 0 1 21 7.5v9a4.5 4.5 0 0 1-4.5 4.5h-9A4.5 4.5 0 0 1 3 16.5v-9A4.5 4.5 0 0 1 7.5 3ZM12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8ZM17 6.5h.01",
  tiktok: "M14 3v11.5a3.5 3.5 0 1 1-3.5-3.5M14 3c.4 2.6 2.4 4.6 5 5",
  phone:
    "M5 4h3l1.5 4-2 1.5a11 11 0 0 0 5 5l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2Z",
  mail: "M4 6h16v12H4zM4 7l8 6 8-6",
  pin: "M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21ZM12 7.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z",
  clock: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18ZM12 7v5l3 2",
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  <path d={paths[name]}></path>
</svg>
