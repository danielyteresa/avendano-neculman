---
import type { PracticeArea } from "../data/types";

interface Props {
  area: PracticeArea;
  /** Posición en la lista, para el número "01", "02"… */
  index: number;
  casesLabel: string;
}

const { area, index, casesLabel } = Astro.props;
const number = String(index + 1).padStart(2, "0");
---

<!-- Sin sombra: las líneas finas entre tarjetas las da el grid de PracticeAreas. -->
<article class="flex w-full flex-col bg-fondo p-8 lg:p-10">
  <p class="font-display text-lg text-dorado-oscuro" aria-hidden="true">
    {number}
  </p>
  <h3 class="mt-4 text-3xl">{area.title}</h3>
  <p class="mt-3 leading-relaxed">{area.summary}</p>
  <p class="sr-only">{casesLabel}</p>
  <ul class="mt-6 space-y-2 border-t border-azul/10 pt-6 text-sm">
    {area.cases.map((c) => (
      <li class="flex gap-3">
        <span
          class="mt-2.5 h-px w-3 shrink-0 bg-dorado-oscuro"
          aria-hidden="true"
        />
        {c}
      </li>
    ))}
  </ul>
</article>
