---
// Franja angosta en crema. Ojo: sobre crema el dorado oscuro no cumple AA,
// así que aquí todo el texto va en azul o tinta.
import { content } from "../data/site";
import { whatsappUrl } from "../lib/links";
import Button from "./ui/Button.astro";
import Icon from "./ui/Icon.astro";

const { onlineBanner: text } = content;
---

<section aria-labelledby="online-titulo" class="bg-crema">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-14 sm:px-6 md:flex-row md:items-center md:justify-between">
    <div>
      <h2 id="online-titulo" class="text-3xl sm:text-4xl">
        {text.text}
      </h2>
      <p class="mt-2">{text.detail}</p>
    </div>
    <Button
      href={whatsappUrl(text.whatsappMessage)}
      target="_blank"
      rel="noopener"
      class="shrink-0"
    >
      <Icon name="whatsapp" class="size-5" />
      {text.cta.label}
      <span class="sr-only">{text.newTabNote}</span>
    </Button>
  </div>
</section>
