---
import type { HTMLAttributes } from "astro/types";

type Variant = "primary" | "gold" | "outline" | "outline-light";

interface Props extends HTMLAttributes<"a"> {
  href: string;
  /**
   * primary: azul, para fondos claros · gold: dorado con texto azul, para el hero ·
   * outline: borde azul para fondos claros · outline-light: borde crema para fondos azules
   */
  variant?: Variant;
}

const { href, variant = "primary", class: className, ...rest } = Astro.props;

// Todos los pares cumplen AA: fondo/azul 15.4, azul/dorado 6.4, crema/azul 13.1.
const variants: Record<Variant, string> = {
  primary: "border border-azul bg-azul text-fondo hover:bg-tinta",
  gold: "border border-dorado bg-dorado text-azul hover:bg-crema hover:border-crema",
  outline: "border border-azul text-azul hover:bg-azul hover:text-fondo",
  "outline-light":
    "border border-crema text-crema hover:bg-crema hover:text-azul",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center gap-2 rounded-sm px-6 py-3 text-sm font-semibold tracking-wide transition-colors",
    variants[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
